# Server-only configuration. Keep real keys in a local, untracked .env file.
APP_ENV=development
APP_MODE=demo
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=sqlite:///../../data/medicall.db

# Required only for live voice calls. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_LANGUAGE=en
# Comma-separated STUN/TURN URLs for deployments outside local development.
VOICE_ICE_SERVERS=
